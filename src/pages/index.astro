        whatsapp: "https://wa.me/56953068872?text=Hola%20Brahuer%20Tours%2C%20quiero%20información%20sobre%20Caj%C3%B3n%20del%20Maipo"
      },
      santiago: {
        titulo: "Experiencias en Santiago",
        descripcion: "Roof & Night (experiencia nocturna) · Campanarios de la Catedral Metropolitana · Amor & Pastas",
        imagenes: [
          "slider/19.jpg",
