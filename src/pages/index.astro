  <script>
    // Mobile menu
    const btn = document.getElementById('menu-btn');
    const menu = document.getElementById('mobile-menu');
    btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
    menu?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => menu.classList.add('hidden'));
    });

    // Slider
    const track = document.getElementById('slider-track');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const dotsContainer = document.getElementById('dots');
    const totalSlides = 4;
    let current = 0;

    // Create dots
    for (let i = 0; i < totalSlides; i++) {
      const dot = document.createElement('button');
      dot.className = `w-2.5 h-2.5 rounded-full transition ${i === 0 ? 'bg-gold-400' : 'bg-zinc-600'}`;
      dot.addEventListener('click', () => goTo(i));
      dotsContainer?.appendChild(dot);
    }

    function updateDots() {
      dotsContainer?.querySelectorAll('button').forEach((dot, i) => {
        dot.className = `w-2.5 h-2.5 rounded-full transition ${i === current ? 'bg-gold-400' : 'bg-zinc-600'}`;
      });
    }

    function goTo(index) {
      current = index;
      if (track) track.style.transform = `translateX(-${current * 100}%)`;
      updateDots();
    }

    prevBtn?.addEventListener('click', () => goTo((current - 1 + totalSlides) % totalSlides));
    nextBtn?.addEventListener('click', () => goTo((current + 1) % totalSlides));

    // Auto play
    setInterval(() => goTo((current + 1) % totalSlides), 5000);

    // Image Slider (15 imágenes)
    const imgTrack = document.getElementById('image-slider-track');
    const imgPrev = document.getElementById('img-prev');
    const imgNext = document.getElementById('img-next');
    const imgDotsContainer = document.getElementById('img-dots');
    const totalImgSlides = 15;
    let currentImg = 0;

    for (let i = 0; i < totalImgSlides; i++) {
      const dot = document.createElement('button');
      dot.className = `w-2.5 h-2.5 rounded-full transition ${i === 0 ? 'bg-gold-400' : 'bg-zinc-600'}`;
      dot.addEventListener('click', () => goToImg(i));
      imgDotsContainer?.appendChild(dot);
    }

    function updateImgDots() {
      imgDotsContainer?.querySelectorAll('button').forEach((dot, i) => {
        dot.className = `w-2.5 h-2.5 rounded-full transition ${i === currentImg ? 'bg-gold-400' : 'bg-zinc-600'}`;
      });
    }

    function goToImg(index) {
      currentImg = index;
      if (imgTrack) imgTrack.style.transform = `translateX(-${currentImg * 100}%)`;
      updateImgDots();
    }

    imgPrev?.addEventListener('click', () => goToImg((currentImg - 1 + totalImgSlides) % totalImgSlides));
    imgNext?.addEventListener('click', () => goToImg((currentImg + 1) % totalImgSlides));

    // Autoplay cada 5 segundos
    setInterval(() => goToImg((currentImg + 1) % totalImgSlides), 5000);

  </script>
