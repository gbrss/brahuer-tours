---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Navbar -->
  <header class="fixed top-0 left-0 right-0 z-50 bg-black/80 backdrop-blur-md border-b border-gold-600/20">
    <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16 md:h-20">
        <a href="/" class="flex items-center gap-2">
          <span class="text-2xl md:text-3xl font-display font-bold tracking-tight">
            <span class="text-white">BRA</span><span class="text-gold-400">H</span><span class="text-white">UER</span>
          </span>
          <span class="text-gold-500 text-sm md:text-base font-medium tracking-widest">TOURS</span>
        </a>
        
        <div class="hidden md:flex items-center gap-8 text-sm font-medium">
          <a href="#servicios" class="text-gray-300 hover:text-gold-400 transition">Servicios</a>
          <a href="#destinos" class="text-gray-300 hover:text-gold-400 transition">Destinos</a>
          <a href="#nosotros" class="text-gray-300 hover:text-gold-400 transition">Nosotros</a>
          <a href="#contacto" class="text-gray-300 hover:text-gold-400 transition">Contacto</a>
        </div>

        <a href="#contacto" class="hidden sm:inline-flex items-center px-5 py-2.5 rounded-full bg-gradient-to-r from-gold-500 to-gold-600 text-black font-semibold text-sm hover:from-gold-400 hover:to-gold-500 transition shadow-lg shadow-gold-500/20">
          Reservar ahora
        </a>
         <a href="https://www.flow.cl/app/web/pagarBtnPago.php?token=n229dc5c0f1e8b310f8ae15a0f67228d045932a0" class="hidden sm:inline-flex items-center px-5 py-2.5 rounded-full bg-gradient-to-r from-gold-500 to-gold-600 text-black font-semibold text-sm hover:from-gold-400 hover:to-gold-500 transition shadow-lg shadow-gold-500/20">
          Cuota 30%
        </a>

        <!-- Mobile menu button -->
        <button id="menu-btn" class="md:hidden p-2 text-gold-400" aria-label="Menú">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </nav>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden bg-black/95 border-t border-gold-600/20">
      <div class="px-4 py-4 space-y-3">
        <a href="#servicios" class="block text-gray-300 hover:text-gold-400 py-2">Servicios</a>
        <a href="#destinos" class="block text-gray-300 hover:text-gold-400 py-2">Destinos</a>
        <a href="#nosotros" class="block text-gray-300 hover:text-gold-400 py-2">Nosotros</a>
        <a href="#contacto" class="block text-gray-300 hover:text-gold-400 py-2">Contacto</a>
        <a href="#contacto" class="block mt-2 text-center px-5 py-2.5 rounded-full bg-gold-500 text-black font-semibold">Reservar ahora</a>
        <a href="https://www.flow.cl/app/web/pagarBtnPago.php?token=n229dc5c0f1e8b310f8ae15a0f67228d045932a0" class="block mt-2 text-center px-5 py-2.5 rounded-full bg-gold-500 text-black font-semibold">Cuota 30%</a>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-20">
    <!-- Background gradient -->
    <div class="absolute inset-0 bg-gradient-to-b from-black via-brand-dark to-black"></div>
    
    <!-- Decorative elements -->
    <div class="absolute top-20 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-gold-500/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-gold-600/5 rounded-full blur-3xl"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Official Chilean flag emoji -->
      <div class="flex items-center justify-center gap-3 mb-6">
        <span class="text-3xl md:text-4xl">🇨🇱</span>
        <span class="text-gold-400/80 text-sm tracking-[0.3em] uppercase">Chile</span>
      </div>

      <!-- Logo image -->
      <div class="mb-8 flex justify-center">
        <img 
          src="/logo.jpg" 
          alt="Brahuer Tours - Turismo y Transporte Chile" 
          class="w-full max-w-md md:max-w-lg lg:max-w-xl rounded-2xl shadow-2xl shadow-gold-500/10 border border-gold-600/20"
        />
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-display font-bold tracking-tight mb-3">
        <span class="text-white">BRA</span><span class="text-gold-400">H</span><span class="text-white">UER</span>
      </h1>
      <p class="text-xl sm:text-2xl md:text-3xl text-gold-500 font-display tracking-widest mb-4">TOURS</p>
      
      <p class="text-lg sm:text-xl text-gray-300 max-w-2xl mx-auto mb-2 font-light">
        Turismo y Transporte
      </p>
      <p class="text-gold-400/90 text-base sm:text-lg italic mb-8 font-display">
        "Tu destino, nuestra ruta"
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#servicios" class="px-8 py-3.5 rounded-full bg-gradient-to-r from-gold-500 to-gold-600 text-black font-semibold text-base hover:from-gold-400 hover:to-gold-500 transition shadow-xl shadow-gold-500/25">
          Descubre nuestros servicios
        </a>
        <a href="#contacto" class="px-8 py-3.5 rounded-full border border-gold-500/50 text-gold-400 font-medium hover:bg-gold-500/10 transition">
          Contáctanos
        </a>
      </div>

      <!-- Services icons preview -->
      <div class="mt-14 grid grid-cols-2 md:grid-cols-4 gap-6 max-w-3xl mx-auto">
        <div class="flex flex-col items-center gap-2 group">
          <div class="w-14 h-14 rounded-full border border-gold-500/40 flex items-center justify-center group-hover:border-gold-400 group-hover:bg-gold-500/10 transition">
            <svg class="w-6 h-6 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
            </svg>
          </div>
          <span class="text-xs text-gray-400 tracking-wider uppercase">Excursiones</span>
        </div>
        <div class="flex flex-col items-center gap-2 group">
          <div class="w-14 h-14 rounded-full border border-gold-500/40 flex items-center justify-center group-hover:border-gold-400 group-hover:bg-gold-500/10 transition">
            <svg class="w-6 h-6 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
            </svg>
          </div>
          <span class="text-xs text-gray-400 tracking-wider uppercase">Traslados</span>
        </div>
        <div class="flex flex-col items-center gap-2 group">
          <div class="w-14 h-14 rounded-full border border-gold-500/40 flex items-center justify-center group-hover:border-gold-400 group-hover:bg-gold-500/10 transition">
            <svg class="w-6 h-6 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <span class="text-xs text-gray-400 tracking-wider uppercase">Destinos</span>
        </div>
        <div class="flex flex-col items-center gap-2 group">
          <div class="w-14 h-14 rounded-full border border-gold-500/40 flex items-center justify-center group-hover:border-gold-400 group-hover:bg-gold-500/10 transition">
            <svg class="w-6 h-6 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
          </div>
          <span class="text-xs text-gray-400 tracking-wider uppercase">Experiencias</span>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-gold-500/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </section>

  <!-- Slider Section -->
<section class="py-16 md:py-20 relative overflow-hidden bg-zinc-950">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <p class="text-gold-500 text-sm tracking-[0.3em] uppercase mb-2">Destinos destacados</p>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold text-white">Descubre Chile con nosotros</h2>
    </div>

    <div class="relative">
      <div id="slider" class="overflow-hidden rounded-2xl border border-gold-600/20">
        <div id="slider-track" class="flex transition-transform duration-500 ease-out">

          <!-- Slide 1: Nieve y Cordillera -->
          <div class="min-w-full px-6 py-12 md:py-16 bg-gradient-to-br from-zinc-900 to-black text-center">
            <div class="text-5xl mb-4">⛷️</div>
            <h3 class="text-2xl font-display font-bold text-gold-400 mb-3">Nieve & Cordillera de los Andes</h3>
            <p class="text-gray-400 max-w-xl mx-auto">
              Parque de Nieve Farellones · Valle Nevado · El Colorado · Andes Panorámico · Portillo & Laguna del Inca · Farellones Sunset
            </p>
          </div>

          <!-- Slide 2: Viñas -->
          <div class="min-w-full px-6 py-12 md:py-16 bg-gradient-to-br from-zinc-900 to-black text-center">
            <div class="text-5xl mb-4">🍷</div>
            <h3 class="text-2xl font-display font-bold text-gold-400 mb-3">Viñas & Experiencias Enológicas</h3>
            <p class="text-gray-400 max-w-xl mx-auto">
              Viña Santa Carolina · Concha y Toro · Santa Rita · Cousiño Macul + Templo Bahá’í · Undurraga + Parque Tricao
            </p>
          </div>

          <!-- Slide 3: Costa y Valparaíso -->
          <div class="min-w-full px-6 py-12 md:py-16 bg-gradient-to-br from-zinc-900 to-black text-center">
            <div class="text-5xl mb-4">🌊</div>
            <h3 class="text-2xl font-display font-bold text-gold-400 mb-3">Costa, Valparaíso & Viña del Mar</h3>
            <p class="text-gray-400 max-w-xl mx-auto">
              Valparaíso & Viña del Mar Full Colors · Vino, Museo Neruda, Valparaíso y Viña del Mar · Isla Negra, Algarrobo & Valle Casablanca
            </p>
          </div>

          <!-- Slide 4: Cajón del Maipo y Naturaleza -->
          <div class="min-w-full px-6 py-12 md:py-16 bg-gradient-to-br from-zinc-900 to-black text-center">
            <div class="text-5xl mb-4">🏔️</div>
            <h3 class="text-2xl font-display font-bold text-gold-400 mb-3">Cajón del Maipo & Naturaleza</h3>
            <p class="text-gray-400 max-w-xl mx-auto">
              Laguna Escondida & Casa Chocolate · Lodge El Morado · Embalse El Yeso · Parque Safari · BuinZoo BioParque
            </p>
          </div>

          <!-- Slide 5: Experiencias en Santiago -->
          <div class="min-w-full px-6 py-12 md:py-16 bg-gradient-to-br from-zinc-900 to-black text-center">
            <div class="text-5xl mb-4">🌃</div>
            <h3 class="text-2xl font-display font-bold text-gold-400 mb-3">Experiencias en Santiago</h3>
            <p class="text-gray-400 max-w-xl mx-auto">
              Roof & Night (experiencia nocturna) · Campanarios de la Catedral Metropolitana · Amor & Pastas
            </p>
          </div>

        </div>
      </div>

      <!-- Controls -->
      <div class="flex items-center justify-center gap-4 mt-6">
        <button id="prev-btn" class="w-10 h-10 rounded-full border border-gold-500/40 text-gold-400 hover:bg-gold-500/10 transition flex items-center justify-center" aria-label="Anterior">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        </button>
        <div id="dots" class="flex gap-2"></div>
        <button id="next-btn" class="w-10 h-10 rounded-full border border-gold-500/40 text-gold-400 hover:bg-gold-500/10 transition flex items-center justify-center" aria-label="Siguiente">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<!-- Image Slider - 7 imágenes sin texto -->
  <section class="py-16 md:py-24 relative overflow-hidden bg-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <p class="text-gold-500 text-sm tracking-[0.3em] uppercase mb-2">Galería</p>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold text-white">Nuestros viajes en imágenes</h2>
        <div class="w-20 h-0.5 bg-gradient-to-r from-transparent via-gold-500 to-transparent mx-auto mt-6"></div>
      </div>

      <div class="relative">
        <div id="image-slider" class="overflow-hidden rounded-2xl border border-gold-600/20 shadow-2xl">
          <div id="image-slider-track" class="flex transition-transform duration-700 ease-out">
            
            <!-- Imagen 1 -->
            <div class="min-w-full">
              <img src="slider/1.jfif" alt="Chile 1" class="w-full h-[320px] sm:h-[420px] md:h-[520px] object-cover" />
            </div>

            <!-- Imagen 2 -->
            <div class="min-w-full">
              <img src="slider/2.jfif" alt="Chile 2" class="w-full h-[320px] sm:h-[420px] md:h-[520px] object-cover" />
            </div>

            <!-- Imagen 3 -->
            <div class="min-w-full">
              <img src="slider/3.jfif" alt="Chile 3" class="w-full h-[320px] sm:h-[420px] md:h-[520px] object-cover" />
            </div>

            <!-- Imagen 4 -->
            <div class="min-w-full">
              <img src="slider/4.jfif" alt="Chile 4" class="w-full h-[320px] sm:h-[420px] md:h-[520px] object-cover" />
            </div>

            <!-- Imagen 5 -->
            <div class="min-w-full">
              <img src="slider/5.jfif" alt="Chile 5" class="w-full h-[320px] sm:h-[420px] md:h-[520px] object-cover" />
            </div>

            <!-- Imagen 6 -->
            <div class="min-w-full">
              <img src="slider/6.jfif" alt="Chile 6" class="w-full h-[320px] sm:h-[420px] md:h-[520px] object-cover" />
            </div>

            <!-- Imagen 7 -->
            <div class="min-w-full">
              <img src="slider/7.jfif" alt="Chile 7" class="w-full h-[320px] sm:h-[420px] md:h-[520px] object-cover" />
            </div>

            <!-- Imagen 8 -->
            <div class="min-w-full">
              <img src="slider/8.jfif" alt="Chile 8" class="w-full h-[320px] sm:h-[420px] md:h-[520px] object-cover" />
            </div>

            <!-- Imagen 9 -->
            <div class="min-w-full">
              <img src="slider/9.jfif" alt="Chile 9" class="w-full h-[320px] sm:h-[420px] md:h-[520px] object-cover" />
            </div>

            <!-- Imagen 10 -->
            <div class="min-w-full">
              <img src="slider/10.jfif" alt="Chile 10" class="w-full h-[320px] sm:h-[420px] md:h-[520px] object-cover" />
            </div>

            <!-- Imagen 11 -->
            <div class="min-w-full">
              <img src="slider/11.jfif" alt="Chile 11" class="w-full h-[320px] sm:h-[420px] md:h-[520px] object-cover" />
            </div>

            <!-- Imagen 12 -->
            <div class="min-w-full">
              <img src="slider/12.jfif" alt="Chile 12" class="w-full h-[320px] sm:h-[420px] md:h-[520px] object-cover" />
            </div>

            <!-- Imagen 13 -->
            <div class="min-w-full">
              <img src="slider/13.jfif" alt="Chile 13" class="w-full h-[320px] sm:h-[420px] md:h-[520px] object-cover" />
            </div>

            <!-- Imagen 14 -->
            <div class="min-w-full">
              <img src="slider/14.jfif" alt="Chile 14" class="w-full h-[320px] sm:h-[420px] md:h-[520px] object-cover" />
            </div>

            <!-- Imagen 15 -->
            <div class="min-w-full">
              <img src="slider/15.jfif" alt="Chile 15" class="w-full h-[320px] sm:h-[420px] md:h-[520px] object-cover" />
            </div>

          </div>
        </div>

        <!-- Flechas -->
        <button id="img-prev" class="absolute left-3 md:left-5 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-black/50 backdrop-blur border border-gold-500/40 text-gold-400 hover:bg-gold-500/20 transition flex items-center justify-center z-10" aria-label="Anterior">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        </button>
        <button id="img-next" class="absolute right-3 md:right-5 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-black/50 backdrop-blur border border-gold-500/40 text-gold-400 hover:bg-gold-500/20 transition flex items-center justify-center z-10" aria-label="Siguiente">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </button>

        <!-- Dots -->
        <div id="img-dots" class="flex justify-center gap-2 mt-6"></div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section id="servicios" class="py-20 md:py-28 relative">
    <div class="absolute inset-0 bg-gradient-to-b from-black via-zinc-950 to-black"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <p class="text-gold-500 text-sm tracking-[0.3em] uppercase mb-3">Lo que ofrecemos</p>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-display font-bold text-white">Nuestros Servicios</h2>
        <div class="w-20 h-0.5 bg-gradient-to-r from-transparent via-gold-500 to-transparent mx-auto mt-6"></div>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
        <!-- Excursiones -->
        <div class="group relative bg-zinc-900/50 border border-gold-600/20 rounded-2xl p-6 hover:border-gold-500/50 transition-all duration-300 hover:-translate-y-1">
          <div class="w-12 h-12 rounded-xl bg-gold-500/10 flex items-center justify-center mb-5 group-hover:bg-gold-500/20 transition">
            <svg class="w-6 h-6 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-white mb-3">Excursiones</h3>
          <p class="text-gray-400 text-sm leading-relaxed">
            Tours guiados a los paisajes más impresionantes de Chile: desde el desierto de Atacama hasta la Patagonia.
          </p>
        </div>

        <!-- Traslados -->
        <div class="group relative bg-zinc-900/50 border border-gold-600/20 rounded-2xl p-6 hover:border-gold-500/50 transition-all duration-300 hover:-translate-y-1">
          <div class="w-12 h-12 rounded-xl bg-gold-500/10 flex items-center justify-center mb-5 group-hover:bg-gold-500/20 transition">
            <svg class="w-6 h-6 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-white mb-3">Traslados</h3>
          <p class="text-gray-400 text-sm leading-relaxed">
            Servicio de transporte privado y corporativo con vehículos modernos y conductores profesionales.
          </p>
        </div>

        <!-- Destinos -->
        <div class="group relative bg-zinc-900/50 border border-gold-600/20 rounded-2xl p-6 hover:border-gold-500/50 transition-all duration-300 hover:-translate-y-1">
          <div class="w-12 h-12 rounded-xl bg-gold-500/10 flex items-center justify-center mb-5 group-hover:bg-gold-500/20 transition">
            <svg class="w-6 h-6 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-white mb-3">Destinos</h3>
          <p class="text-gray-400 text-sm leading-relaxed">
            Conoce los mejores lugares de Chile con itinerarios personalizados adaptados a tus intereses.
          </p>
        </div>

        <!-- Experiencias -->
