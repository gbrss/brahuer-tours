        ],
        mapa: "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3330!2d-70.669!3d-33.448!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9662c5a5a5a5a5a5%3A0x0!2sSantiago!5e0!3m2!1ses!2scl!4v1700000000000",
        whatsapp: "https://wa.me/56953068872?text=Hola%20Brahuer%20Tours%2C%20quiero%20información%20sobre%20Experiencias%20en%20Santiago"
      }
    };

    let currentModalSlide = 0;

    window.abrirModal = function(id) {
      const data = destinosData[id];
      if (!data) return;

      document.getElementById('modal-titulo').textContent = data.titulo;
      document.getElementById('modal-descripcion').textContent = data.descripcion;
      document.getElementById('modal-mapa').src = data.mapa;
      document.getElementById('modal-whatsapp').href = data.whatsapp;

      const trackModal = document.getElementById('modal-track');
      trackModal.innerHTML = data.imagenes.map((src, i) => `
        <div class="min-w-full bg-black">
          <img src="${src}" class="w-full h-64 sm:h-72 md:h-80 object-cover" alt="${data.titulo} ${i + 1}" loading="${i < 2 ? 'eager' : 'lazy'}">
        </div>
      `).join('');

      // Si alguna foto aún no existe en /public, se omite sin romper el modal
      trackModal.querySelectorAll('img').forEach(img => {
        img.addEventListener('error', () => {
          img.parentElement.remove();
          modalGo(Math.min(currentModalSlide, trackModal.children.length - 1));
        });
      });

      modalGo(0);

      const modal = document.getElementById('destino-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    };

    function cerrarModal() {
      const modal = document.getElementById('destino-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    }

    document.getElementById('cerrar-modal')?.addEventListener('click', cerrarModal);
    document.getElementById('destino-modal')?.addEventListener('click', (e) => {
      if (e.target.id === 'destino-modal') cerrarModal();
    });

    function modalGo(index) {
      const t = document.getElementById('modal-track');
      const total = t.children.length;
      if (!total) return;
      currentModalSlide = (index + total) % total;
      t.style.transform = `translateX(-${currentModalSlide * 100}%)`;
      const c = document.getElementById('modal-counter');
      if (c) c.textContent = `${currentModalSlide + 1} / ${total}`;
    }

    document.getElementById('modal-prev')?.addEventListener('click', () => modalGo(currentModalSlide - 1));
    document.getElementById('modal-next')?.addEventListener('click', () => modalGo(currentModalSlide + 1));

    // ===== Swipe táctil para los carruseles =====
    function enableSwipe(el, onPrev, onNext) {
      if (!el) return;
      el.style.touchAction = 'pan-y';
      let startX = 0, startY = 0, tracking = false;
      el.addEventListener('touchstart', (e) => {
        const t = e.touches[0];
        startX = t.clientX; startY = t.clientY; tracking = true;
      }, { passive: true });
      el.addEventListener('touchend', (e) => {
        if (!tracking) return;
        tracking = false;
        const t = e.changedTouches[0];
        const dx = t.clientX - startX;
        const dy = t.clientY - startY;
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) {
          dx < 0 ? onNext() : onPrev();
        }
      }, { passive: true });
      el.addEventListener('touchcancel', () => { tracking = false; }, { passive: true });
    }

    enableSwipe(document.getElementById('slider'),
      () => goTo((current - 1 + totalSlides) % totalSlides),
      () => goTo((current + 1) % totalSlides));
    enableSwipe(document.getElementById('image-slider'),
      () => goToImg((currentImg - 1 + totalImgSlides) % totalImgSlides),
      () => goToImg((currentImg + 1) % totalImgSlides));
    enableSwipe(document.getElementById('modal-slider'),
      () => modalGo(currentModalSlide - 1),
      () => modalGo(currentModalSlide + 1));
  </script>
